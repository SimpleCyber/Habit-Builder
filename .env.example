# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and populate with your own values.
# NEVER commit .env.local or real API secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ variables are exposed to the client bundle (safe for public identifiers)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# SERVER-ONLY CREDENTIALS (DO NOT prefix with NEXT_PUBLIC_)
# Used exclusively in secure server-side Next.js route handlers
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_api_key:your_cloudinary_api_secret@your_cloudinary_cloud_name

# ------------------------------------------------------------------------------
# FIREBASE CONFIGURATION (CLIENT SDK)
# Note: Client keys are public by design in Firebase architecture.
# Data protection is enforced via Firestore Security Rules (firestore.rules).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# APPLICATION & ADMIN CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of emails with access to /admin routes
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

